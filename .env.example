# Copy to .env. Local development (npm run dev, cargo run) reads it.
# docker compose reads it too, but sets its own DATABASE_URL and PORT for each container.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-bytes
# The public origin. Locally this is the Vite dev server.
BETTER_AUTH_URL=http://localhost:5173
# Postgres from docker compose. Change the port if you start it with POSTGRES_PORT.
DATABASE_URL=postgres://jurno:jurno@localhost:5433/jurno
# Encrypts broker API keys (Exness sync) in the database: 32 bytes, base64 (openssl rand -base64 32).
# Keep it secret and keep it: without the same key, stored broker keys cannot be read.
CREDENTIALS_KEY=
# The reminder email. Without RESEND_API_KEY, emails are written to the api log instead.
RESEND_API_KEY=
EMAIL_FROM=Jurno <reminders@jurno.app>
# Links in emails use this origin. Defaults to BETTER_AUTH_URL.
# PUBLIC_URL=http://localhost:5173
# Set to off to hide the Exness connection and stop the sync job.
# EXNESS_SYNC=off
